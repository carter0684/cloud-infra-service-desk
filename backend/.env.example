# Copy to backend/.env (git-ignored) for LOCAL development. In AWS the same
# values are set as environment variables on the ECS task by the CDK
# (infra-cdk/config.json -> "extra_env"). See README "Configuration".

ENV=local

# ── Organisation identity (backend/app/org_config.py) ─────────────────────
ORG_NAME=Example Corp
PORTAL_DOMAIN=portal.example.com
API_DOMAIN=portal-api.example.com
ORG_EMAIL_DOMAIN=example.com
# REQUIRED: founding admins (comma-separated). They can never be locked out.
SEED_ADMIN_EMAILS=admin@example.com
SEED_USER_NAMES=admin@example.com=Admin User
SES_SENDER_ADDRESS=portal@example.com

# ── AWS accounts the portal depends on ────────────────────────────────────
PORTAL_HOST_ACCOUNT_ID=
CORE_ACCOUNT_ID=
KNOWN_BUSINESS_UNITS=Platform,Product
# Optional JSON list that pre-loads the Cloud Accounts registry
# CLOUD_ACCOUNT_SEED_FILE=./accounts.json

# ── Core account credentials for LOCAL runs only (never commit real keys) ──
# CORE_ACCESS_KEY_ID=
# CORE_SECRET_ACCESS_KEY=

# ── Optional integrations (all OFF unless listed) ─────────────────────────
# ENABLED_FEATURES=aws_ams,s2s_vpn,vpn_lookup,meraki
# FRESHSERVICE_DOMAIN=yourcompany.freshservice.com
# AMS_ACCOUNT_ID=
# VPN_LOOKUP_ACCOUNT_ID=
# S2S_VPN_ACCOUNT_ID=
# S2S_VPN_TGW_CONFIG={"us-east-1":{"name":"TGW-US","id":"tgw-...","route_table_name":"TGW-US-RT","route_table_id":"tgw-rtb-..."}}
# WHITELIST_LMS_ACCOUNT_ID=
# SECURITY_PORTAL_API_BASE=https://security.example.com/external-api
# SECURITY_PORTAL_PUBLIC_URL=https://security.example.com
# FS_CALENDAR_API_BASE=
# SR_TICKET_API_BASE=
# LICENSING_DASHBOARD_URL=
# SCREENSAVER_BUCKET_NAME=
# SCREENSAVER_CLOUDFRONT_DOMAIN=
# RESOURCE_INVENTORY_BUCKET=
# MERAKI_ORG_ID=
# FORTIGATE_INSTANCE_URL=
# PATCHING_DEFAULT_TEAMS_MEETINGS=[{"id":"web","name":"Web servers","url":"https://teams.microsoft.com/l/meetup-join/..."}]
